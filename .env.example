# Cadena de conexión de DESARROLLO.
# Formato: gestor://usuario:contraseña@servidor:puerto/base_de_datos
# Si la contraseña tiene símbolos como @ # / : deben escribirse codificados (por ejemplo @ = %40).
DATABASE_URL=postgresql://postgres:Postgres123!@localhost:5432/library_dev

# Cadena de conexión de PRUEBAS. Debe ser una base DISTINTA a la de desarrollo:
# las pruebas de integración vacían la tabla.
TEST_DATABASE_URL=postgresql://postgres:Postgres123!@localhost:5432/library_dev_test

# Dónde se guardan los libros:
#   memory -> en memoria (opción por defecto si la variable no existe)
#   sql    -> PostgreSQL (necesita DATABASE_URL)
BOOKS_ADAPTER=sql

PORT=3000
